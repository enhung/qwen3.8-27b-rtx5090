# Copy to .env and fill in. Both `docker compose` and `setup.sh` read this file.

# Bearer key for the vLLM OpenAI-compatible API (Authorization: Bearer <key>).
# Leave empty to run without authentication (local networks only!).
VLLM_API_KEY=

# Host ports (unset = defaults 8020 / 8030). Container-side ports are fixed
# (vllm 8000, caddy 8030) — only the host mapping changes.
#VLLM_HOST_PORT=8020
#GATEWAY_HOST_PORT=8030

# Model selection (all optional — unset keys keep the defaults for the stock
# Qwen3.8-27B NVFP4 model). Uncomment and adjust to switch models.
#MODEL_REPO=gittensor-model-hub/Qwen3.8-27B-NVFP4-RTX5090
#MODEL_SUBDIR=qwen3.8-27b-nvfp4
#SERVED_MODEL_NAME=qwen3.8-27b
#CONTAINER_NAME=vllm

# Model weights are pinned to a known-good Hugging Face revision (the default
# in setup.sh). Set to another revision sha to fetch that state, or to an
# empty string to always download the latest weights.
#MODEL_REVISION=0cc27958cefbbe231782ec8511de8c4eb5233348

# --- vLLM performance mode (serve flags in docker-compose.yml /
# docker-compose.mtp.yml) ---
# Light setup (default, no MTP): leave BOTH unset — the base file serves
# with --max-num-seqs 16 and --gpu-memory-utilization 0.95, the sensible
# profile for a shared host (the card may still drive the display / run
# other workloads).
#
# MTP (heavy usage, dedicated card): enable MTP speculative decoding (the
# model's built-in MTP layers draft 2 tokens per step — faster decode) by
# running with the override file, which ships the ideal-usage tuning
# (3 concurrent sequences at 0.965, the shipped full-MTP tuning
# ≈120–170 tok/s single-stream decode, full native 256K context) — no
# rebuild needed, no .env keys:
#   docker compose -f docker-compose.yml -f docker-compose.mtp.yml up -d
# It wants a dedicated card (nothing else on the RTX 5090: no HDMI/DP
# display output, desktop env on the iGPU if needed, and no other GPU
# workloads — check the card is idle via `nvidia-smi`).
#
# Deviate from MTP's tuning only when needed, via the two keys — e.g.
# run MTP on a shared host at the light values:
#VLLM_GPU_MEMORY_UTILIZATION=0.95
#VLLM_MAX_NUM_SEQS=16
# The two keys are global: a value set in `.env` applies to BOTH the base
# and the MTP command lists (the MTP override's built-ins are only the
# fallback when the key is unset).

# --- Monitoring (caddy / prometheus / grafana services in docker-compose.yml) ---

# Login for the auto-provisioned Grafana vLLM dashboard (http://<host>:3000):
#GRAFANA_ADMIN_USER=admin
#GRAFANA_ADMIN_PASSWORD=choose-a-long-random-string
# (applied only on first Grafana DB init; rotate later via the Grafana UI)

# HTTP Basic auth for the caddy gateway (port 8030, routes /v1/*, /metrics, /dcgm/metrics).
# If METRICS_HASH is missing/empty, caddy will not start (fail-closed).
# METRICS_HASH must be the bcrypt hash of METRICS_PASSWORD:
#   python3 -c "import bcrypt;print(bcrypt.hashpw(input().encode(),bcrypt.gensalt(12)).decode()).replace('$2b$','$2a$')"
#   (caddy/Go expects the $2a$ prefix, hence the replace(); the one-liner
#   needs Python's `bcrypt` module, e.g. `pip install bcrypt`)
#METRICS_USER=metrics
#METRICS_PASSWORD=
#METRICS_HASH=
