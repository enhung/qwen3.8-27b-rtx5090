          "expr": "sum(rate(vllm:spec_decode_num_accepted_tokens_total[5m])) / sum(rate(vllm:spec_decode_num_draft_tokens_total[5m]))",
          "legendFormat": "accepted",
          "refId": "A"
        },
        {
          "expr": "(sum(rate(vllm:spec_decode_num_draft_tokens_total[5m])) - sum(rate(vllm:spec_decode_num_accepted_tokens_total[5m]))) / sum(rate(vllm:spec_decode_num_draft_tokens_total[5m]))",
